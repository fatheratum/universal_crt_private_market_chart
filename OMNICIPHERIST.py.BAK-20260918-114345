def fetch_live_price(pair):
    """
    Fetches live price for the given Forex or Crypto pair.
    Uses real-time MT5 feed for Forex (biquote) and CoinGecko for Crypto.
    """
    try:
        # === REAL-TIME FOREX (MT5 feed – no key, ultra live) ===
        if len(pair) == 6 and pair.isalpha():  # classic Forex pair e.g. GBPJPY
            symbol = pair.upper()
            url = f"https://biquote.io/api/{symbol}"
            response = requests.get(url, timeout=8)
            data = response.json()

            if "mid" in data and data.get("stale") is False:
                price = float(data["mid"])
                print(colored(f"✅ Real-Time Live Price for {symbol}: {price:.5f}", "cyan"))
                return price
            elif "bid" in data and "ask" in data:
                price = (float(data["bid"]) + float(data["ask"])) / 2
                print(colored(f"✅ Real-Time Live Price for {symbol}: {price:.5f}", "cyan"))
                return price
            else:
                print(colored(f"❌ Unexpected response from live feed for {symbol}", "red"))
                return None

        # === FALLBACK to old daily API (kept only as last resort) ===
        response = requests.get(FOREX_API_URL, params={"apikey": FOREX_API_KEY})
        data = response.json()
        print(colored("📡 Forex API Raw Response (fallback):", "yellow"), data)

        rates = data["rates"]
        base, quote = pair[:3].upper(), pair[3:].upper()

        if base in rates and quote in rates:
            price = rates[quote] / rates[base]
            print(colored(f"✅ Fallback Price for {base}/{quote}: {price:.5f}", "cyan"))
            return price

        print(colored(f"❌ Could not compute price for {pair}.", "red"))
        return None

    except Exception as e:
        print(colored(f"❌ Live price fetch error: {e}", "red"))
        return None

    except Exception as e:
        print(colored(f"❌ Forex API error: {e}", "red"))
        return None

    # 🔥 Crypto Pair Logic fallback
    try:
        response = requests.get(f"{COINGECKO_API_URL}simple/price", params={
            "ids": pair.lower(),
            "vs_currencies": "usd"
        })
        data = response.json()
        price = data.get(pair.lower(), {}).get("usd")

        if price:
            print(colored(f"🪙 Crypto {pair.upper()} Price: ${price}", "cyan"))
            return price
        else:
            print(colored(f"❌ Crypto pair {pair} price not found.", "red"))
            return None

    except Exception as e:
        print(colored(f"❌ CoinGecko API error: {e}", "red"))
        return None

