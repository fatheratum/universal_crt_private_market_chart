def _multi_menu(buf):
    x1,x2=1,110
    y1=max(0,HEIGHT-30)
    y2=max(y1+8,HEIGHT-3)
    for y in range(y1,y2+1):
        put(buf,x1,y,"|",BLUE)
        put(buf,x2,y,"|",BLUE)
    for x in range(x1,x2+1):
        put(buf,x,y1,"-",BLUE)
        put(buf,x,y2,"-",BLUE)
    put(buf,x1,y1,"+",BLUE)
    put(buf,x2,y1,"+",BLUE)
    put(buf,x1,y2,"+",BLUE)
    put(buf,x2,y2,"+",BLUE)
    put(buf,x1+2,3,"MULTI-CHART MENU",YELLOW)
    items=[
        ("OPEN NEW CHART","ENTER"),
        ("VIEW LIST","V"),
        ("TOGGLE CHART","G"),
        ("ZOOM IN","+"),
        ("ZOOM OUT","-"),
        ("TIMEFRAME","T"),
        ("AUTO-ADJUST","A"),
        ("REFRESH ALL","R")
    ]
    for i,(name,key) in enumerate(items):
        y=4+i*2
        selected=i==MULTI_MENU
        c=CYAN if selected else WHITE
        put(buf,x1+1,y,">" if selected else " ",c)
        put(buf,x1+3,y,name[:15],c)
        put(buf,x1+18,y,key[:2],DIM)
    base=20
    if MULTI_VIEW_LIST:
        for i,c in enumerate(MULTI_CHARTS):
            y=base+i*2
            if y>=30:break
            selected=MULTI_MENU==base//2+i
            mark="ON" if c["visible"] else "OFF"
            col=CYAN if selected else WHITE
            put(buf,x1+1,y,">" if selected else " ",col)
            put(buf,x1+3,y,c["pair"][:11],col)
            put(buf,x1+15,y,mark,DIM)
    else:
        put(buf,x1+3,20,"FAVORITES",YELLOW)
        for i,c in enumerate(MULTI_CHARTS):
            y=22+i*2
            if y>=30:break
            mark="ON" if c["visible"] else "OFF"
            col=CYAN if MULTI_MENU==9+i else WHITE
            put(buf,x1+1,y,">" if MULTI_MENU==9+i else " ",col)
            put(buf,x1+3,y,c["pair"][:11],col)
            put(buf,x1+15,y,mark,DIM)
def _multi_menu_action():
    global MULTI_MENU,MULTI_VIEW_LIST,MULTI_MENU_CHART
    if MULTI_MENU==0:
        _multi_open_chart()
        return
    if MULTI_MENU==1:
        MULTI_VIEW_LIST=not MULTI_VIEW_LIST
        MULTI_MENU_CHART=0
        return
    if MULTI_MENU==2:
        if MULTI_CHARTS:
            if MULTI_VIEW_LIST:
                i=clamp(MULTI_MENU_CHART,0,len(MULTI_CHARTS)-1)
            else:
                i=clamp(MULTI_MENU-9,0,len(MULTI_CHARTS)-1)
            _multi_remove_or_toggle(i)
        return
    if MULTI_MENU==3:
        for c in _multi_visible():
            c["zoom"]=clamp(round(c["zoom"]+0.25,2),0.5,3.0)
        return
    if MULTI_MENU==4:
        for c in _multi_visible():
            c["zoom"]=clamp(round(c["zoom"]-0.25,2),0.5,3.0)
        return
    if MULTI_MENU==5:
        i=TF_ORDER.index(state["tf"])
        state["tf"]=TF_ORDER[(i+1)%len(TF_ORDER)]
        for c in MULTI_CHARTS:
            if c["visible"]:
                c["tf"]=state["tf"]
                rows=_fetch_pair(c["pair"],c["tf"])
                if rows:c["data"]=rows
        return
    if MULTI_MENU==6:
        for c in _multi_visible():
            c["auto"]=not c["auto"]
        return
    if MULTI_MENU==7:
        for c in MULTI_CHARTS:
            c["last_refresh"]=0
        _multi_refresh()
        return
    if MULTI_VIEW_LIST and MULTI_MENU>=10:
        i=MULTI_MENU-10
        if 0<=i<len(MULTI_CHARTS):
            MULTI_MENU_CHART=i
            _multi_remove_or_toggle(i)
        return
    if not MULTI_VIEW_LIST and MULTI_MENU>=9:
        i=MULTI_MENU-9
        if 0<=i<len(MULTI_CHARTS):
            MULTI_MENU_CHART=i
            _multi_remove_or_toggle(i)
def _multi_key(k):
    global MULTI_MENU,MULTI_MENU_CHART,MULTI_VIEW_LIST
    if k=="UP":
        MULTI_MENU=max(0,MULTI_MENU-1)
        return
    if k=="DOWN":
        max_menu=8
        if MULTI_VIEW_LIST:
            max_menu=9+len(MULTI_CHARTS)
        elif MULTI_CHARTS:
            max_menu=8+len(MULTI_CHARTS)
        MULTI_MENU=min(max_menu,MULTI_MENU+1)
        return
    if k=="RIGHT":
        if MULTI_MENU==3:
            for c in _multi_visible():c["zoom"]=clamp(round(c["zoom"]+0.25,2),0.5,3.0)
        elif MULTI_MENU==4:
            for c in _multi_visible():c["zoom"]=clamp(round(c["zoom"]-0.25,2),0.5,3.0)
        return
    if k=="LEFT":
        if MULTI_MENU==3:
            for c in _multi_visible():c["zoom"]=clamp(round(c["zoom"]-0.25,2),0.5,3.0)
        elif MULTI_MENU==4:
            for c in _multi_visible():c["zoom"]=clamp(round(c["zoom"]+0.25,2),0.5,3.0)
        return
    if k in ("\r","\n"):
        _multi_menu_action()
        return
    kl=k.lower()
    if kl=="q":
        state["running"]=False
    elif kl=="n":
        _multi_open_chart()
    elif kl=="v":
        MULTI_VIEW_LIST=not MULTI_VIEW_LIST
        MULTI_MENU=1
    elif kl=="g":
        if MULTI_CHARTS:
            i=clamp(MULTI_MENU_CHART,0,len(MULTI_CHARTS)-1)
            _multi_remove_or_toggle(i)
    elif kl=="r":
        for c in MULTI_CHARTS:c["last_refresh"]=0
        _multi_refresh()
    elif kl=="t":
        i=(TF_ORDER.index(state["tf"])+1)%len(TF_ORDER)
        state["tf"]=TF_ORDER[i]
        for c in MULTI_CHARTS:
            if c["visible"]:
                c["tf"]=state["tf"]
                rows=_fetch_pair(c["pair"],c["tf"])
                if rows:c["data"]=rows
    elif kl=="a":
        for c in _multi_visible():c["auto"]=not c["auto"]
    elif kl=="z":
        for c in _multi_visible():c["zoom"]=clamp(round(c["zoom"]+0.25,2),0.5,3.0)
    elif kl=="x":
        for c in _multi_visible():c["zoom"]=clamp(round(c["zoom"]-0.25,2),0.5,3.0)
def _multi_render():
    rowsbuf=[[" " for _ in range(WIDTH)] for _ in range(HEIGHT)]
    put(rowsbuf,1,0,"UNIVERSAL CRT V3 | MULTI-CHART MARKET RASTER",CYAN)
    put(rowsbuf,1,1,"FIXED VIEWPORTS | OHLC MAPPING | LIVE PAIR DATA | REVEALABILITY",DIM)
    visible_charts=_multi_visible()
    if not visible_charts:
        put(rowsbuf,5,8,"NO CHARTS VISIBLE",YELLOW)
        put(rowsbuf,5,10,"SELECT OPEN NEW CHART",WHITE)
    else:
        slots=_multi_slots(len(visible_charts))
        for c,(top,bottom) in zip(visible_charts,slots):
            _multi_draw_chart(c,top,bottom,rowsbuf)
    _multi_menu(rowsbuf)
    footer_y=max(0,HEIGHT-2)
    put(rowsbuf,1,footer_y,"↑ ↓ SELECT  ← → ADJUST  ENTER ACTIVATE  Z/X ZOOM  T TIMEFRAME  A AUTO  R REFRESH  Q QUIT",WHITE)
    global FIRST_FRAME
    if FIRST_FRAME:
        sys.stdout.write("\033[2J\033[H")
        FIRST_FRAME=False
    for y in range(HEIGHT):
        sys.stdout.write(_ansi_at(0,y)+"".join(rowsbuf[y]))
    sys.stdout.flush()
def main():
    global WIDTH,HEIGHT,FIRST_FRAME,MULTI_MENU,MULTI_MENU_CHART
    term=shutil.get_terminal_size((WIDTH,HEIGHT))
    WIDTH=max(112,min(WIDTH,term.columns))
    HEIGHT=max(32,term.lines)
    rows=_fetch_pair("BTC-USD",state["tf"])
    if not rows:rows=fetch_candles()
    _multi_add_chart("BTC-USD",state["tf"])
    if rows and MULTI_CHARTS:
        MULTI_CHARTS[0]["data"]=rows
    MULTI_MENU=0
    MULTI_MENU_CHART=0
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        FIRST_FRAME=True
        while state["running"]:
            _multi_refresh()
            _multi_render()
            if select.select([fd],[],[],0.25)[0]:
                _multi_key(_read_key(fd))
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
        sys.stdout.write("\033[0m\033[?25h")
        sys.stdout.flush()
if __name__=="__main__":
    main()
