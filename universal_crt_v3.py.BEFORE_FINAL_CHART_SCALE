    if CHART_B-CHART_T>=7:
        draw_time(buf,rows,centers)
    put(buf,CHART_L+2,CHART_T-1,c["pair"]+" | "+c["tf"]+" | LIVE | "+str(len(rows))+" CANDLES",CYAN)
    last=rows[-1]
