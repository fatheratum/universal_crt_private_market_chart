#!/usr/bin/env python3
import sys,time,select,termios,tty,shutil,json,urllib.request,urllib.parse,ssl
WIDTH=112
HEIGHT=32
CHART_L,CHART_R=5,84
CHART_T,CHART_B=4,23
AXIS_L,AXIS_R=85,88
MENU_L,MENU_R=90,110
GREEN="\033[32m"
RED="\033[31m"
CYAN="\033[36m"
BLUE="\033[34m"
YELLOW="\033[33m"
WHITE="\033[37m"
DIM="\033[2m"
RESET="\033[0m"
BOLD="\033[1m"
TF={"1m":60,"5m":300,"15m":900,"1h":3600,"4h":21600,"1d":86400}
TF_ORDER=["1m","5m","15m","1h","4h","1d"]
state={"tf":"1h","zoom":1.0,"auto":True,"running":True,"menu":0,"status":"LIVE"}
DATA=[]
def clamp(v,a,b):
    return max(a,min(b,v))
def api_url(tf):
    return "https://api.exchange.coinbase.com/products/BTC-USD/candles?granularity="+str(TF[tf])
def fetch_candles():
    try:
        req=urllib.request.Request(api_url(state["tf"]),headers={"User-Agent":"UniversalCRT/3.0","Accept":"application/json"})
        with urllib.request.urlopen(req,timeout=5,context=ssl.create_default_context()) as r:
            raw=json.loads(r.read().decode())
        rows=[]
        for x in reversed(raw):
            if len(x)>=6:
                ts,lo,hi,op,cl,vol=x[:6]
                rows.append({"ts":int(ts),"o":float(op),"h":float(hi),"l":float(lo),"c":float(cl),"v":float(vol)})
        if rows:
            return rows[-120:]
    except Exception:
        pass
    return fallback_data()
def fallback_data():
    base=81000.0
    out=[]
    seed=[0.002,-0.001,0.003,0.001,-0.002,0.004,-0.003,0.002,0.001,-0.004,0.003,-0.001,0.002,-0.003,0.004,-0.002,0.001,0.003,-0.002,0.001,-0.001,0.003,-0.002,0.002]
    now=int(time.time()//TF[state["tf"]])*TF[state["tf"]]
    for i,p in enumerate(seed):
        o=base
        c=o*(1+p)
        h=max(o,c)*(1+abs(p)*1.8+0.001)
        l=min(o,c)*(1-abs(p)*1.8-0.001)
        out.append({"ts":now-(len(seed)-i)*TF[state["tf"]],"o":o,"h":h,"l":l,"c":c,"v":0.0})
        base=c
    return out
def aggregate(rows,target):
    if not rows:return []
    if target=="1m":return rows
    sec=TF[target]
    groups={}
    for r in rows:
        k=(r["ts"]//sec)*sec
        groups.setdefault(k,[]).append(r)
    out=[]
    for k,g in sorted(groups.items()):
        out.append({"ts":k,"o":g[0]["o"],"h":max(x["h"] for x in g),"l":min(x["l"] for x in g),"c":g[-1]["c"],"v":sum(x["v"] for x in g)})
    return out
def visible(rows):
    if not rows:return []
    n=round(24/state["zoom"])
    n=clamp(n,10,min(60,len(rows)))
    return rows[-n:]
def price_range(rows):
    lo=min(r["l"] for r in rows)
    hi=max(r["h"] for r in rows)
    if hi<=lo:hi=lo+1
    span=hi-lo
    pad=span*0.08
    if state["auto"]:
        lo-=pad
        hi+=pad
    return lo,hi
def py(price,lo,hi):
    usable=CHART_B-CHART_T
    return int(round(CHART_B-(price-lo)/(hi-lo)*usable))
def money(v):
    if v>=1000000:return f"{v/1000000:.2f}M"
    if v>=1000:return f"{v/1000:.1f}k"
    return f"{v:.0f}"
def put(buf,x,y,s,color=""):
    if y<0 or y>=HEIGHT:return
    if x>=WIDTH or x+len(s)<=0:return
    a=max(0,-x)
    s=s[a:]
    x=max(0,x)
    if x>=WIDTH:return
    s=s[:WIDTH-x]
    for i,ch in enumerate(s):
        if ch!=" ":
            buf[y][x+i]=(color+ch+RESET if color else ch)
def frame(buf):
    for x in range(CHART_L,CHART_R+1):
        put(buf,x,CHART_T,"-",BLUE)
        put(buf,x,CHART_B,"-",BLUE)
    for y in range(CHART_T,CHART_B+1):
        put(buf,CHART_L,y,"|",BLUE)
        put(buf,CHART_R,y,"|",BLUE)
    put(buf,CHART_L,CHART_T,"+",BLUE)
    put(buf,CHART_R,CHART_T,"+",BLUE)
    put(buf,CHART_L,CHART_B,"+",BLUE)
    put(buf,CHART_R,CHART_B,"+",BLUE)
    for y in range(CHART_T+4,CHART_B,4):
        for x in range(CHART_L+1,CHART_R):
            if buf[y][x]==" ":buf[y][x]=DIM+"."+RESET
    for x in range(CHART_L+10,CHART_R,10):
        for y in range(CHART_T+1,CHART_B):
            if buf[y][x]==" ":buf[y][x]=DIM+"."+RESET
def draw_price_axis(buf,lo,hi):
    for i in range(6):
        p=hi-(hi-lo)*i/5
        y=round(CHART_T+(CHART_B-CHART_T)*i/5)
        put(buf,AXIS_L,y,money(p),CYAN)
def draw_candles(buf,rows,lo,hi):
    n=len(rows)
    left=CHART_L+2
    right=CHART_R-2
    span=right-left
    slot=span/(n-1 if n>1 else 1)
    body_w=max(1,min(2,int(slot*0.55)))
    centers=[]
    for i,r in enumerate(rows):
        x=int(round(left+i*slot))
        centers.append(x)
        yo=clamp(py(r["o"],lo,hi),CHART_T+1,CHART_B-1)
        yc=clamp(py(r["c"],lo,hi),CHART_T+1,CHART_B-1)
        yh=clamp(py(r["h"],lo,hi),CHART_T+1,CHART_B-1)
        yl=clamp(py(r["l"],lo,hi),CHART_T+1,CHART_B-1)
        color=GREEN if r["c"]>=r["o"] else RED
        for y in range(yh,yl+1):
            put(buf,x,y,"|",color)
        top=min(yo,yc)
        bot=max(yo,yc)
        if top==bot:bot=min(CHART_B-1,top+1)
        for xx in range(x-body_w//2,x+body_w-body_w//2):
            for y in range(top,bot+1):
                put(buf,xx,y,"#",color)
    return centers
def draw_trend(buf,rows,lo,hi,centers):
    if len(rows)<2:return
    for i in range(len(rows)-1):
        x1,x2=centers[i],centers[i+1]
        y1=clamp(py(rows[i]["c"],lo,hi),CHART_T+1,CHART_B-1)
        y2=clamp(py(rows[i+1]["c"],lo,hi),CHART_T+1,CHART_B-1)
        dx=x2-x1
        if dx<=0:continue
        for x in range(x1+1,x2):
            t=(x-x1)/dx
            y=round(y1+(y2-y1)*t)
            if CHART_T<y<CHART_B and buf[y][x]==" ":
                buf[y][x]=DIM+"."+RESET
def draw_time(buf,rows,centers):
    if not rows:return
    for i in range(0,len(rows),max(1,len(rows)//6)):
        x=centers[i]
        label=time.strftime("%H:%M",time.localtime(rows[i]["ts"]))
        if x-2>=CHART_L and x+3<=CHART_R:put(buf,x-2,CHART_B+1,label,DIM)
def menu(buf):
    for y in range(2,26):
        put(buf,MENU_L,y,"|",BLUE)
        put(buf,MENU_R,y,"|",BLUE)
    for x in range(MENU_L,MENU_R+1):
        put(buf,x,2,"-",BLUE)
        put(buf,x,25,"-",BLUE)
    put(buf,MENU_L,2,"+",BLUE);put(buf,MENU_R,2,"+",BLUE)
    put(buf,MENU_L,25,"+",BLUE);put(buf,MENU_R,25,"+",BLUE)
    put(buf,MENU_L+2,4,"CONTROL PANEL",YELLOW)
    items=[("1","ZOOM CONTROLS"),("2","TIMEFRAME SNAP"),("3","AUTO-ADJUST"),("4","REFRESH DATA"),("Q","QUIT")]
    for i,(k,v) in enumerate(items):
        y=7+i*3
        c=CYAN if state["menu"]==i else WHITE
        put(buf,MENU_L+2,y,k+"  "+v,c)
    put(buf,MENU_L+2,22,"Z/X  ZOOM",DIM)
    put(buf,MENU_L+2,23,"T    TIMEFRAME",DIM)
def header(buf):
    put(buf,1,0,"UNIVERSAL CRT V3 | BTC/USD | MATHEMATICAL MARKET RASTER",CYAN)
    put(buf,1,1,"OHLC -> PRICE MAP -> FIXED CANDLE SLOTS -> CLIPPED VIEWPORT",DIM)
def footer(buf,rows):
    if not rows:return
    last=rows[-1]
    ch=GREEN if last["c"]>=last["o"] else RED
    trend="UP" if last["c"]>=rows[0]["c"] else "DOWN"
    put(buf,1,27,f"BTC/USD  {state['tf']}  ZOOM {state['zoom']:.2f}  CANDLES {len(rows):02d}  LAST {last['c']:,.2f}",ch)
    put(buf,1,28,f"RANGE {money(min(r['l'] for r in rows))} - {money(max(r['h'] for r in rows))}  TREND {trend}  AUTO {'ON' if state['auto'] else 'OFF'}",DIM)
    put(buf,1,30,"[Z] IN  [X] OUT  [T] TIMEFRAME  [A] AUTO  [R] REFRESH  [Q] QUIT",WHITE)
def render():
    rows=visible(aggregate(DATA,state["tf"]))
    if not rows:return
    lo,hi=price_range(rows)
    buf=[[" " for _ in range(WIDTH)] for _ in range(HEIGHT)]
    header(buf)
    frame(buf)
    centers=draw_candles(buf,rows,lo,hi)
    draw_trend(buf,rows,lo,hi,centers)
    draw_price_axis(buf,lo,hi)
    draw_time(buf,rows,centers)
    menu(buf)
    footer(buf,rows)
    sys.stdout.write("\033[H\033[2J")
    sys.stdout.write("\n".join("".join(r) for r in buf))
    sys.stdout.flush()
def refresh():
    global DATA
    DATA=fetch_candles()
def keypress(fd):
    old=termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:return sys.stdin.read(1)
    finally:termios.tcsetattr(fd,termios.TCSADRAIN,old)
def handle(k):
    k=k.lower()
    if k=="q":
        state["running"]=False
    elif k=="z":
        state["zoom"]=clamp(round(state["zoom"]+0.25,2),0.5,3.0)
    elif k=="x":
        state["zoom"]=clamp(round(state["zoom"]-0.25,2),0.5,3.0)
    elif k=="a":
        state["auto"]=not state["auto"]
    elif k=="r":
        refresh()
    elif k=="t":
        i=(TF_ORDER.index(state["tf"])+1)%len(TF_ORDER)
        state["tf"]=TF_ORDER[i]
        refresh()
    elif k in "1234":
        state["menu"]=int(k)-1
        if k=="3":state["auto"]=not state["auto"]
        if k=="4":refresh()
    elif k=="+":
        state["zoom"]=clamp(round(state["zoom"]+0.25,2),0.5,3.0)
    elif k=="-":
        state["zoom"]=clamp(round(state["zoom"]-0.25,2),0.5,3.0)
def main():
    global WIDTH,HEIGHT
    term=shutil.get_terminal_size((WIDTH,HEIGHT))
    WIDTH=max(100,min(WIDTH,term.columns))
    HEIGHT=max(32,min(HEIGHT,term.lines))
    refresh()
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    try:
        while state["running"]:
            render()
            if select.select([fd],[],[],1.0)[0]:
                handle(sys.stdin.read(1))
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
        sys.stdout.write("\033[0m\033[2J\033[H")
        sys.stdout.flush()
if __name__=="__main__":
    main()
