def _workspace_frame(c):
    if "frame" not in c:c["frame"]=0
    if "range" not in c:c["range"]=(0.0,0.0)
    if "lo" not in c:c["lo"]=0.0
    if "hi" not in c:c["hi"]=0.0
    if "last_refresh" not in c:c["last_refresh"]=0.0
    _multi_refresh()
    rows=c.get("data",[])
    if not rows:
        c["frame"]+=1
        return [],0.0,0.0
    lows=[]
    highs=[]
    for r in rows:
        try:
            if isinstance(r,dict):
                o=float(r.get("open",r.get("o",0.0)))
                h=float(r.get("high",r.get("h",o)))
                l=float(r.get("low",r.get("l",o)))
                cl=float(r.get("close",r.get("c",o)))
            else:
                o=float(r[1])
                h=float(r[2])
                l=float(r[3])
                cl=float(r[4])
            lows.append(min(o,h,l,cl))
            highs.append(max(o,h,l,cl))
        except (TypeError,ValueError,IndexError):
            continue
    if not lows or not highs:
        c["frame"]+=1
        return rows,0.0,0.0
    lo=min(lows)
    hi=max(highs)
    span=max(1e-12,hi-lo)
    pad=span*0.03
    lo-=pad
    hi+=pad
    span=max(1e-12,hi-lo)
    c["frame"]+=1
    c["lo"]=lo
    c["hi"]=hi
    c["range"]=(lo,hi)
    c["range_span"]=span
    c["mid"]=(hi+lo)/2.0
    c["normalized_range"]=span/max(1e-12,abs(c["mid"]))
    c["data"]=rows
    return rows,lo,hi

def _multi_draw_workspace(c):
    W=WIDTH
    H=HEIGHT
    CHART_T=4
    CHART_B=23
    CHART_L=5
    CHART_R=84
    AXIS_L=85
    AXIS_R=88
    buf=[[" "]*W for _ in range(H)]
    pair=c.get("pair","BTC-USD")
    tf=c.get("tf","1h")
    zoom=max(0.1,float(c.get("zoom",1.0)))
    auto=bool(c.get("auto",True))
    rows,lo,hi=_workspace_frame(c)
    if rows:
        if auto:
            span=max(1e-12,hi-lo)
            center=(hi+lo)/2.0
            span/=zoom
            lo=center-span/2.0
            hi=center+span/2.0
        else:
            lo=float(c.get("lo",lo))
            hi=float(c.get("hi",hi))
        c["lo"]=lo
        c["hi"]=hi
        c["range"]=(lo,hi)
    put(buf,0,0,"UNIVERSAL CRT V3 | MULTI-CHART MARKET RASTER")
    put(buf,1,0,"WORKSPACE 112x32 | INDEPENDENT OHLC | LIVE PAIR DATA | REVEALABILITY")
    for x in range(CHART_L,CHART_R+1):
        buf[CHART_T-1][x]="─"
        buf[CHART_B+1][x]="─"
    for y in range(CHART_T,CHART_B+1):
        buf[y][CHART_L]="│"
        buf[y][CHART_R]="│"
    buf[CHART_T-1][CHART_L]="┌"
    buf[CHART_T-1][CHART_R]="┐"
    buf[CHART_B+1][CHART_L]="└"
    buf[CHART_B+1][CHART_R]="┘"
    for y in range(CHART_T,CHART_B+1):
        buf[y][AXIS_L]="│"
    if rows:
        put(buf,2,CHART_L+1,f"{hi:.8f}")
        put(buf,2,CHART_R-18,f"{lo:.8f}")
        n=len(rows)
        usable=max(1,CHART_R-CHART_L-1)
        slot=usable/max(1,n)
        for i,r in enumerate(rows):
            try:
                if isinstance(r,dict):
                    o=float(r.get("open",r.get("o",0.0)))
                    h=float(r.get("high",r.get("h",o)))
                    l=float(r.get("low",r.get("l",o)))
                    cl=float(r.get("close",r.get("c",o)))
                else:
                    o=float(r[1])
                    h=float(r[2])
                    l=float(r[3])
                    cl=float(r[4])
            except (TypeError,ValueError,IndexError):
                continue
            x=CHART_L+1+int(i*slot)
            if x>=CHART_R:x=CHART_R-1
            def py(v):
                q=(v-lo)/max(1e-12,hi-lo)
                return int(round(CHART_B-max(0.0,min(1.0,q))*(CHART_B-CHART_T)))
            yh=py(h)
            yl=py(l)
            yo=py(o)
            yc=py(cl)
            top=min(yo,yc)
            bottom=max(yo,yc)
            body_w=max(1,min(3,int(slot*0.7)))
            left=max(CHART_L+1,x-body_w//2)
            right=min(CHART_R-1,left+body_w-1)
            for y in range(yh,yl+1):
                if CHART_T<=y<=CHART_B:
                    buf[y][x]="┃"
            for y in range(top,bottom+1):
                if CHART_T<=y<=CHART_B:
                    for xx in range(left,right+1):
                        buf[y][xx]="█"
        try:
            last=rows[-1]
            close=float(last.get("close",last.get("c",0.0))) if isinstance(last,dict) else float(last[4])
            q=(close-lo)/max(1e-12,hi-lo)
            y=int(round(CHART_B-max(0.0,min(1.0,q))*(CHART_B-CHART_T)))
            if CHART_T<=y<=CHART_B:
                put(buf,y,AXIS_L+1,f"{close:.8f}")
        except (TypeError,ValueError,IndexError):
            pass
    else:
        put(buf,13,CHART_L+15,"WAITING FOR MARKET DATA")
    return buf

def _multi_menu(buf):
